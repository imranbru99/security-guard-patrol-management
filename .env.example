# =============================================================================
# GuardOps — environment template
# Copy to .env and fill in secrets. Never commit real credentials.
# Docker Compose defaults: http://localhost:8080  |  Mailpit: :8025
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=GuardOps
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database (MySQL 8 in Docker; SQLite for CI / local tests)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=guardops
DB_USERNAME=guardops
DB_PASSWORD=secret
# DB_ROOT_PASSWORD=rootsecret

# SQLite (tests / CI):
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

# -----------------------------------------------------------------------------
# Session / filesystem
# -----------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Cache / queue / Redis
# -----------------------------------------------------------------------------
CACHE_STORE=redis
# CACHE_PREFIX=guardops_

QUEUE_CONNECTION=redis
# QUEUE_FAILED_DRIVER=database-uuids

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_DB=0
# REDIS_CACHE_DB=1

MEMCACHED_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# Broadcasting / Laravel Reverb (WebSockets)
# Host ports in docker-compose: Reverb 8081, app HTTP 8080
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=guardops
REVERB_APP_KEY=guardops-key
REVERB_APP_SECRET=guardops-secret
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# -----------------------------------------------------------------------------
# Mail (Mailpit in Docker: SMTP 1025, UI http://localhost:8025)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@guardops.test"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# AWS / S3 (optional media / evidence vault)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Sanctum (API tokens + SPA stateful domains)
# -----------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,127.0.0.1,127.0.0.1:8080
SANCTUM_TOKEN_PREFIX=

# -----------------------------------------------------------------------------
# GuardOps product
# -----------------------------------------------------------------------------
DEMO_MODE=false
GUARDOPS_DEFAULT_CURRENCY=USD

# -----------------------------------------------------------------------------
# Maps (Leaflet + OSM by default; Google optional)
# -----------------------------------------------------------------------------
MAPS_PROVIDER=leaflet
MAPS_DEFAULT_LAT=23.8103
MAPS_DEFAULT_LNG=90.4125
MAPS_DEFAULT_ZOOM=12
# MAPS_GOOGLE_API_KEY=
# MAPS_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# -----------------------------------------------------------------------------
# Attendance Hub (imrandevbd/laravel-attendance-hub)
# -----------------------------------------------------------------------------
ATTENDANCE_TENANCY_ENABLED=true
ATTENDANCE_DEFAULT_PROVIDER=zkteco
ATTENDANCE_TIMEZONE="${APP_TIMEZONE}"
ATTENDANCE_DEVICE_TIMEZONE=UTC
ATTENDANCE_ADMS_ENABLED=true
ATTENDANCE_ADMS_INTERVAL=30
ATTENDANCE_ADMS_ERROR_DELAY=60
ATTENDANCE_BRIDGE_TOKEN=
ATTENDANCE_MAX_ATTEMPTS=3
ATTENDANCE_BACKOFF_SECONDS=30
ATTENDANCE_POLL_INTERVAL=300
ATTENDANCE_GEOFENCE_RADIUS=100
ATTENDANCE_QR_VALIDITY=60
ATTENDANCE_DEBOUNCE_MINUTES=2
ATTENDANCE_ANTI_PASSBACK=false
ATTENDANCE_WEBHOOKS_ENABLED=false
ATTENDANCE_WEBHOOK_SECRET=
ATTENDANCE_WEBHOOK_ENDPOINTS=
ATTENDANCE_FILAMENT_ENABLED=true

# -----------------------------------------------------------------------------
# Drutogoti performance profiling
# -----------------------------------------------------------------------------
DRUTOGOTI_ENABLED=true
DRUTOGOTI_STORAGE_DRIVER=queue
DRUTOGOTI_QUEUE_CONNECTION="${QUEUE_CONNECTION}"
DRUTOGOTI_QUEUE_NAME=default
DRUTOGOTI_SAMPLE_RATE=1.0
DRUTOGOTI_WATCHER_QUERIES_ENABLED=true
DRUTOGOTI_WATCHER_CACHE_ENABLED=true
DRUTOGOTI_WATCHER_COOKIES_ENABLED=true
DRUTOGOTI_WATCHER_IMAGES_ENABLED=true

# -----------------------------------------------------------------------------
# AI Hub (imrandevbd/laravel-ai-hub) — all AI features go through this
# Leave keys empty in demo; canned responses are used when DEMO_MODE=true
# -----------------------------------------------------------------------------
AI_HUB_PROVIDER=openai
AI_HUB_FAILOVER=true
AI_HUB_TIMEOUT=180
AI_HUB_UI=true
AI_HUB_PATH=ai-hub
AI_HUB_AUTHORIZE=true
AI_HUB_ROLES=
AI_HUB_GATE=viewAiHub
AI_HUB_EMAILS=
AI_HUB_SETTINGS_DB=true
AI_HUB_LOGGING=true
AI_HUB_LOGGING_ASYNC=after_response
AI_HUB_QUEUE=default
AI_HUB_LOG_PRUNE_DAYS=90
AI_HUB_BUDGET_MONTHLY=
AI_HUB_BUDGET_ON_EXCEED=block
AI_HUB_FILAMENT=true

AI_HUB_OPENAI_MODEL=gpt-4o-mini
AI_HUB_GEMINI_MODEL=gemini-2.0-flash
AI_HUB_CLAUDE_MODEL=claude-3-5-sonnet-latest

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# -----------------------------------------------------------------------------
# AI Catalog (depends on AI Hub)
# -----------------------------------------------------------------------------
# AI_CATALOG_ENABLED=true

# -----------------------------------------------------------------------------
# Docker Compose port forwards (optional overrides)
# -----------------------------------------------------------------------------
# APP_PORT=8080
# FORWARD_DB_PORT=3306
# FORWARD_REDIS_PORT=6379
# FORWARD_REVERB_PORT=8081
# FORWARD_MAILPIT_UI_PORT=8025
# FORWARD_MAILPIT_SMTP_PORT=1025

# -----------------------------------------------------------------------------
# Vite
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
